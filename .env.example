# Copy this file to .env and replace the Discord values and salt. Never commit .env.
DISCORD_TOKEN=replace-with-your-discord-bot-token
GUILD_ID=123456789012345678
# Keep this password in sync with both URLs below.
POSTGRES_PASSWORD=restock
DATABASE_URL=postgresql+psycopg://restock:restock@localhost:5432/restock
RESTOCK_TEST_DATABASE_URL=postgresql+psycopg://restock:restock@localhost:5432/restock_test
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
REPORTER_HASH_SALT=replace-with-a-long-random-salt
LOG_LEVEL=INFO
